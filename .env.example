# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth (used by node-service)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Node service ─────────────────────────────────────────────────────────────
PORT=4000
DATABASE_URL=mysql://root:password@localhost:3306/draftly
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://draftly:draftly@localhost:5672
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-aes-256-gcm
AI_SERVICE_URL=http://localhost:8000
SESSION_SECRET=change-me-session-secret

# ── Stripe (billing) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/settings?upgrade=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?upgrade=cancelled

# ── Python AI service ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Docker Compose overrides (used inside containers) ────────────────────────
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=draftly
RABBITMQ_DEFAULT_USER=draftly
RABBITMQ_DEFAULT_PASS=draftly
