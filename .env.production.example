NODE_ENV=production

# Public URLs
NEXTAUTH_URL=https://your-frontend.example.com
NEXT_PUBLIC_API_URL=https://your-api.example.com/api
NODE_SERVICE_URL=https://your-api.example.com

# Node service
PORT=4000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/draftly
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672
AI_SERVICE_URL=http://ai-service:8000
SESSION_SECRET=replace-with-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-key
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=/var/log/draftly/node-service
LOG_RETENTION_DAYS=14
LOG_PRUNE_INTERVAL_MS=21600000

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GCP_PROJECT_ID=
GMAIL_WATCH_TOPIC=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://your-frontend.example.com/settings?upgrade=success
STRIPE_CANCEL_URL=https://your-frontend.example.com/settings?upgrade=cancelled

# AI service
OPENROUTER_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-20250514
HOST=0.0.0.0
PORT=8000
PROMPT_VERSION=v1
LOG_TO_FILE=true
LOG_DIR=/var/log/draftly/ai-service
LOG_RETENTION_DAYS=14
LOG_PRUNE_INTERVAL_SECONDS=21600

# Docker backend compose
MYSQL_ROOT_PASSWORD=replace-with-strong-password
MYSQL_DATABASE=draftly
RABBITMQ_DEFAULT_USER=draftly
RABBITMQ_DEFAULT_PASS=replace-with-strong-password
