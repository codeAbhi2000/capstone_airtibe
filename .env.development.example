NODE_ENV=development

# Frontend
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Node service
PORT=4000
NODE_SERVICE_URL=http://localhost:4000
DATABASE_URL=mysql://root:password@localhost:3306/draftly
RABBITMQ_URL=amqp://draftly:draftly@localhost:5672
AI_SERVICE_URL=http://localhost:8000
SESSION_SECRET=dev-change-me-session-secret
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-aes-256-gcm
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_RETENTION_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GCP_PROJECT_ID=
GMAIL_WATCH_TOPIC=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/settings?upgrade=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?upgrade=cancelled

# AI service
OPENROUTER_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-20250514
HOST=0.0.0.0
AI_PORT=8000
PROMPT_VERSION=v1

# Docker local dependencies
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=draftly
MYSQL_PORT=3306
RABBITMQ_DEFAULT_USER=draftly
RABBITMQ_DEFAULT_PASS=draftly
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
