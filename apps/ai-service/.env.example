# ── OpenRouter (for Anthropic models) ─────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_SECONDS=8

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/email_service

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost/
RABBITMQ_EXCHANGE=email.topic
DRAFT_QUEUE=draft.queue
DRAFT_ROUTING_KEY=email.draft
DLQ_NAME=draft.dlq
DLQ_ROUTING_KEY=email.draft.dead

# ── HTTP Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CLIENT_TIMEOUT_SECONDS=10

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PROMPT_VERSION=v1
